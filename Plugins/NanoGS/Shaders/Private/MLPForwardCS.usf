// OIT MLP前向推理 (Mobile-GS OpaictyPhiNN)
//
// 批量协作: 每个threadgroup(256线程)处理 MLP_BATCH_SIZE 个splat
// 权重只从全局内存读一次, 应用到所有splat — 最大化缓存复用
//
// 网络结构:
//   Input(MLPInputDim) → Linear(256)+ReLU → Linear(128)+ReLU → Linear(64)
//     ├→ Linear(1)+ReLU    → phi
//     └→ Linear(1)+Sigmoid → opacity

#include "/Engine/Private/Common.ush"

ByteAddressBuffer PositionBuffer;
ByteAddressBuffer ScaleBuffer;
ByteAddressBuffer RotationBuffer;
ByteAddressBuffer ColorOpacityBuffer;
ByteAddressBuffer SHBuffer;
StructuredBuffer<float> MLPWeightsBuffer;
RWStructuredBuffer<float2> PhiOpacityBuffer;

// ===== Cluster-level visibility (可选, 仅 UseMLPCulling!=0 时读取) =====
// 来自 ClusterCullingCS 的产物, 与 CompactSplats.usf / CalcViewDataOIT.usf 语义完全一致.
// UseMLPCulling=0 时, 这四个 buffer 可以是任何有效 SRV (不会被采样).
StructuredBuffer<uint> SplatClusterIndexBuffer;
StructuredBuffer<uint> ClusterVisibilityBitmap;
StructuredBuffer<uint> LODClusterSelectedBitmap;
StructuredBuffer<uint> SelectedClusterBuffer;

float3 CameraPosition;
uint SplatCount;
float OpacityScale;
uint MLPInputDim;
uint SHCoeffCount;

// ===== Pre-MLP 裁剪开关 =====
// 0 = 全量推理 (原行为, 不读任何 cluster buffer)
// 1 = 按 cluster 可见性/LOD 位图跳过不可见 splat 的全部推理工作
uint UseMLPCulling;
uint UseClusterCulling;   // 0 = 无 cluster 数据 (相当于关掉 MLP 裁剪)
uint UseLODRendering;     // 0 = 不渲染 LOD splat; 1 = 按 LODClusterSelectedBitmap 选中
uint OriginalSplatCount;  // 原始 splat 数; [0, OriginalSplatCount) 是原 splat, 其后是 LOD splat

#define H1 256
#define H2 128
#define H3 64
#define BATCH MLP_BATCH_SIZE    // C++端定义, 默认16
#define MAX_SHARED_DIM 128      // max(MAX_INPUT_DIM, H2)

// Shared memory: 16×256×4 + 16×128×4 = 16KB + 8KB = 24KB
groupshared float gs_h[BATCH][H1];              // Layer1输出 / Layer3输出复用
groupshared float gs_buf[BATCH][MAX_SHARED_DIM]; // 输入组装 / Layer2输出复用

// 可见性槽位标记 (仅 UseMLPCulling!=0 时有意义): 0=跳过, 1=做完整推理
groupshared uint gs_valid[BATCH];
// 本线程组内有效 splat 数; 若 ==0 则整组提前返回, 省掉 Phase 1~4 的协作矩阵乘
groupshared uint gs_validCount;

// 与 CompactSplats.usf:44-97 完全对齐的可见性判定.
// 不可见的 splat: 原始 splat 的叶 cluster 不在视锥内 / 或被父 LOD 吃掉;
// LOD splat 的父 cluster 没被选中.
bool IsSplatVisibleForMLP(uint splatIndex)
{
    if (UseMLPCulling == 0) return true;     // 全量推理路径
    if (UseClusterCulling == 0) return true; // 该 proxy 没 cluster 数据 → 不能裁

    uint clusterIndex = SplatClusterIndexBuffer[splatIndex];
    bool isLODSplat = (splatIndex >= OriginalSplatCount);

    if (isLODSplat)
    {
        // LOD splat: 父 cluster 被选中才渲染
        if (UseLODRendering == 0) return false;
        uint bitmapIdx = clusterIndex / 32u;
        uint bitMask   = 1u << (clusterIndex % 32u);
        return (LODClusterSelectedBitmap[bitmapIdx] & bitMask) != 0u;
    }
    else
    {
        // 原始 splat: 先看叶 cluster 是否视锥内
        uint bitmapIdx = clusterIndex / 32u;
        uint bitMask   = 1u << (clusterIndex % 32u);
        if ((ClusterVisibilityBitmap[bitmapIdx] & bitMask) == 0u)
            return false;

        // 再看是否被父 LOD 覆盖 (selectedClusterID != 自己)
        if (UseLODRendering != 0)
        {
            uint packedSelected = SelectedClusterBuffer[clusterIndex];
            uint selectedClusterID = packedSelected & 0x00FFFFFFu;
            if (selectedClusterID != clusterIndex)
                return false; // 交给父 LOD splat 去渲染
        }
        return true;
    }
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint TIdx : SV_GroupIndex)
{
    uint baseSplat = GroupId.x * BATCH;

    // 重置有效计数
    if (TIdx == 0)
        gs_validCount = 0;
    if (TIdx < BATCH)
        gs_valid[TIdx] = 0;
    GroupMemoryBarrierWithGroupSync();

    // ===== 占位符路径 =====
    if (MLPInputDim == 0)
    {
        if (TIdx < BATCH)
        {
            uint si = baseSplat + TIdx;
            if (si < SplatCount)
            {
                uint packed = ColorOpacityBuffer.Load(si * 4);
                float op = ((packed >> 24) & 0xFF) / 255.0 * OpacityScale;
                PhiOpacityBuffer[si] = float2(1.0, op);
            }
        }
        return;
    }

    // ===== 权重偏移 =====
    uint offW1 = 0;
    uint offB1 = H1 * MLPInputDim;
    uint offW2 = offB1 + H1;
    uint offB2 = offW2 + H2 * H1;
    uint offW3 = offB2 + H2;
    uint offB3 = offW3 + H3 * H2;
    uint offWphi = offB3 + H3;
    uint offBphi = offWphi + H3;
    uint offWop = offBphi + 1;
    uint offBop = offWop + H3;

    // ===== Phase 0: 组装输入 (前BATCH个线程, 每个组装1个splat) =====
    // 同时做可见性门控: 不可见 splat 直接写 (phi=0, opacity=0) 并把自己的 gs_buf
    // 清零, 不占 Phase 1~4 的实际计算 (但仍需要参与协作写, 所以 gs_buf 必须是零).
    if (TIdx < BATCH)
    {
        uint si = baseSplat + TIdx;
        bool isInRange = (si < SplatCount);
        bool isVisible = false;

        if (isInRange)
        {
            isVisible = IsSplatVisibleForMLP(si);
            if (!isVisible)
            {
                // cluster 剔除: 写 phi=0 / opacity=0. 下游 Splatting 用
                // α = opacity · exp(-phi²·mahal), opacity=0 → α=0 → 无屏幕贡献.
                PhiOpacityBuffer[si] = float2(0.0, 0.0);
            }
        }

        if (isVisible)
        {
            gs_valid[TIdx] = 1;
            InterlockedAdd(gs_validCount, 1);

            uint idx = 0;

            // SH系数 (fp16 → fp32, L2-normalize)
            uint shCount = SHCoeffCount * 3;
            uint shBytes = shCount * 2;
            uint shBase = si * shBytes;
            float normSq = 0.0;
            for (uint s = 0; s < shCount; s += 2)
            {
                uint packed = SHBuffer.Load(shBase + s * 2);
                float v0 = f16tof32(packed & 0xFFFF);
                float v1 = f16tof32(packed >> 16);
                if (idx < MAX_SHARED_DIM) { gs_buf[TIdx][idx] = v0; normSq += v0 * v0; idx++; }
                if (s + 1 < shCount && idx < MAX_SHARED_DIM) { gs_buf[TIdx][idx] = v1; normSq += v1 * v1; idx++; }
            }
            float invN = (normSq > 1e-12) ? rsqrt(normSq) : 0.0;
            for (uint n = 0; n < idx; n++)
                gs_buf[TIdx][n] *= invN;

            // ========================================================
            // MLP训练样本在 PLY 空间 (X-right, Y-down, Z-forward, 右手系),
            // 而 PositionBuffer / ScaleBuffer / RotationBuffer 在 PLY 加载
            // 阶段被 PLYFileReader 转到 UE-local 空间 (X-fwd, Y-right, Z-up,
            // 左手系, 单位 cm). 这里把这些 per-splat 输入反向变换回 PLY 空间
            // 再送入 MLP, 与训练输入分布一致.
            //
            // PLYFileReader 的转换关系 (见 PLYFileReader.cpp:344-373):
            //   UE.X =  PLY.Z * 100        |   UE-quat.X = -PLY-quat.Z
            //   UE.Y =  PLY.X * 100        |   UE-quat.Y = -PLY-quat.X
            //   UE.Z = -PLY.Y * 100        |   UE-quat.Z =  PLY-quat.Y
            //                              |   UE-quat.W =  PLY-quat.W
            //   scale: UE = permute(PLY.zxy) × exp × 100   (无 sign 翻转)
            //
            // 反向 (UE → PLY):
            //   pos_PLY   = (UE.y, -UE.z, UE.x) / 100      (normalize 吸收 /100)
            //   scale_PLY = (UE.y,  UE.z, UE.x) / 100      (normalize 吸收 /100)
            //   quat_PLY  = (-UE.y, UE.z, -UE.x, UE.w)
            //
            // CameraPosition 已在 C++ 侧转到 PLY 空间, 此处可直接减.
            // ========================================================

            // viewdir (PLY 空间)
            float3 pos_ue = asfloat(PositionBuffer.Load3(si * 12));
            float3 pos_ply = float3(pos_ue.y, -pos_ue.z, pos_ue.x);
            float3 vd = normalize(pos_ply - CameraPosition);
            gs_buf[TIdx][idx++] = vd.x;
            gs_buf[TIdx][idx++] = vd.y;
            gs_buf[TIdx][idx++] = vd.z;

            // scale (PLY 空间, L2-normalize)
            float3 sc_ue = asfloat(ScaleBuffer.Load3(si * 12));
            float3 sc = float3(sc_ue.y, sc_ue.z, sc_ue.x);
            float scSq = dot(sc, sc);
            sc *= (scSq > 1e-12) ? rsqrt(scSq) : 0.0;
            gs_buf[TIdx][idx++] = sc.x;
            gs_buf[TIdx][idx++] = sc.y;
            gs_buf[TIdx][idx++] = sc.z;

            // rotation (PLY 空间的 quat, 训练时 Python 按 (w,x,y,z) 顺序送入 MLP)
            float4 rot_ue = asfloat(RotationBuffer.Load4(si * 16));
            float4 rot = float4(-rot_ue.y, rot_ue.z, -rot_ue.x, rot_ue.w); // PLY (x,y,z,w)
            gs_buf[TIdx][idx++] = rot.w; // ← 关键：先 w
            gs_buf[TIdx][idx++] = rot.x;
            gs_buf[TIdx][idx++] = rot.y;
            gs_buf[TIdx][idx++] = rot.z;
        }
        else
        {
            // 越界或被剔除: 把 gs_buf 清零, 让 Phase 1~4 的 MAC 仍然合法 (0·w=0)
            // 避免读到未初始化数据污染相邻 valid splat 的中间结果.
            for (uint i = 0; i < MAX_SHARED_DIM; i++)
                gs_buf[TIdx][i] = 0.0;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // 整个 threadgroup 的 BATCH 个 splat 全被剔除 → 跳过 Phase 1~4
    // (Phase 1~4 每个权重只读一次但会遍历所有 BATCH, 跳过整组能省下 MLP 全部 FMA)
    if (UseMLPCulling != 0 && gs_validCount == 0)
        return;

    // ===== Phase 1: Layer1 (InputDim → 256) + ReLU =====
    // 256个线程全部参与, 线程TIdx计算输出节点TIdx, 处理所有BATCH个splat
    // 每个权重值只从全局内存读一次, 乘以所有splat的对应输入
    {
        float sums[BATCH];
        float bias = MLPWeightsBuffer[offB1 + TIdx];
        for (uint s = 0; s < BATCH; s++)
            sums[s] = bias;

        uint rowBase = offW1 + TIdx * MLPInputDim;
        for (uint k = 0; k < MLPInputDim; k++)
        {
            float w = MLPWeightsBuffer[rowBase + k];
            for (uint s = 0; s < BATCH; s++)
                sums[s] += w * gs_buf[s][k];
        }

        for (uint s = 0; s < BATCH; s++)
            gs_h[s][TIdx] = max(sums[s], 0.0);
    }
    GroupMemoryBarrierWithGroupSync();

    // ===== Phase 2: Layer2 (256 → 128) + ReLU =====
    // 256线程全部参与: 分为2组×128线程, 每组处理 BATCH/2 个splat
    // 结果写入 gs_buf (复用, 不再需要原始输入)
    {
        uint outIdx = TIdx & 127u;          // TIdx % 128
        uint group = TIdx >> 7u;            // TIdx / 128 → 0 or 1
        uint sBase = group * (BATCH / 2);
        uint sEnd = sBase + (BATCH / 2);

        float sums[BATCH / 2];
        float bias = MLPWeightsBuffer[offB2 + outIdx];
        for (uint s = 0; s < BATCH / 2; s++)
            sums[s] = bias;

        uint rowBase = offW2 + outIdx * H1;
        for (uint k = 0; k < H1; k++)
        {
            float w = MLPWeightsBuffer[rowBase + k];
            for (uint s = 0; s < BATCH / 2; s++)
                sums[s] += w * gs_h[sBase + s][k];
        }

        for (uint s = 0; s < BATCH / 2; s++)
            gs_buf[sBase + s][outIdx] = max(sums[s], 0.0);
    }
    GroupMemoryBarrierWithGroupSync();

    // ===== Phase 3: Layer3 (128 → 64), 无激活 =====
    // 256线程: 4组×64线程, 每组处理 BATCH/4 个splat
    // 结果写入 gs_h 的前64列
    {
        uint outIdx = TIdx & 63u;           // TIdx % 64
        uint group = TIdx >> 6u;            // TIdx / 64 → 0..3
        uint sBase = group * (BATCH / 4);

        float sums[BATCH / 4];
        float bias = MLPWeightsBuffer[offB3 + outIdx];
        for (uint s = 0; s < BATCH / 4; s++)
            sums[s] = bias;

        uint rowBase = offW3 + outIdx * H2;
        for (uint k = 0; k < H2; k++)
        {
            float w = MLPWeightsBuffer[rowBase + k];
            for (uint s = 0; s < BATCH / 4; s++)
                sums[s] += w * gs_buf[sBase + s][k];
        }

        for (uint s = 0; s < BATCH / 4; s++)
            gs_h[sBase + s][outIdx] = sums[s];
    }
    GroupMemoryBarrierWithGroupSync();

    // ===== Phase 4: 输出头 (前BATCH个线程) =====
    if (TIdx < BATCH)
    {
        uint si = baseSplat + TIdx;
        // 可见性门控: 不可见 splat 的 PhiOpacityBuffer 已在 Phase 0 写过 (0,0),
        // 这里不能覆盖 — 因为 Phase 1~4 的中间结果对该 slot 是 "0 输入 MLP" 产物,
        // 不是真实 phi/opacity.
        // UseMLPCulling=0 时 IsSplatVisibleForMLP 永远返回 true → gs_valid[TIdx]=1,
        // 走 `gs_valid != 0` 分支也能落地, 这里短路成 UseMLPCulling==0 只是少读 1 次
        // groupshared, 对编译器友好.
        bool shouldWrite = (si < SplatCount) && (UseMLPCulling == 0 || gs_valid[TIdx] != 0);
        if (shouldWrite)
        {
            // Phi: Linear(64→1) + ReLU
            float phi = MLPWeightsBuffer[offBphi];
            for (uint k = 0; k < H3; k++)
                phi += MLPWeightsBuffer[offWphi + k] * gs_h[TIdx][k];
            phi = max(phi, 0.0);

            // Opacity: Linear(64→1) + Sigmoid
            float opLogit = MLPWeightsBuffer[offBop];
            for (uint k = 0; k < H3; k++)
                opLogit += MLPWeightsBuffer[offWop + k] * gs_h[TIdx][k];

            PhiOpacityBuffer[si] = float2(phi, 1.0 / (1.0 + exp(-opLogit)));
        }
    }
}
