// OIT MLP前向推理 (Mobile-GS OpaictyPhiNN)
//
// 批量协作: 每个threadgroup(256线程)处理 MLP_BATCH_SIZE 个splat
// 权重只从全局内存读一次, 应用到所有splat — 最大化缓存复用
//
// 网络结构:
//   Input(MLPInputDim) → Linear(256)+ReLU → Linear(128)+ReLU → Linear(64)
//     ├→ Linear(1)+ReLU    → phi
//     └→ Linear(1)+Sigmoid → opacity

#include "/Engine/Private/Common.ush"

ByteAddressBuffer PositionBuffer;
ByteAddressBuffer ScaleBuffer;
ByteAddressBuffer RotationBuffer;
ByteAddressBuffer ColorOpacityBuffer;
ByteAddressBuffer SHBuffer;
StructuredBuffer<float> MLPWeightsBuffer;
RWStructuredBuffer<float2> PhiOpacityBuffer;

float3 CameraPosition;
uint SplatCount;
float OpacityScale;
uint MLPInputDim;
uint SHCoeffCount;

#define H1 256
#define H2 128
#define H3 64
#define BATCH MLP_BATCH_SIZE    // C++端定义, 默认16
#define MAX_SHARED_DIM 128      // max(MAX_INPUT_DIM, H2)

// Shared memory: 16×256×4 + 16×128×4 = 16KB + 8KB = 24KB
groupshared float gs_h[BATCH][H1];              // Layer1输出 / Layer3输出复用
groupshared float gs_buf[BATCH][MAX_SHARED_DIM]; // 输入组装 / Layer2输出复用

[numthreads(THREADGROUP_SIZE, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint TIdx : SV_GroupIndex)
{
    uint baseSplat = GroupId.x * BATCH;

    // ===== 占位符路径 =====
    if (MLPInputDim == 0)
    {
        if (TIdx < BATCH)
        {
            uint si = baseSplat + TIdx;
            if (si < SplatCount)
            {
                uint packed = ColorOpacityBuffer.Load(si * 4);
                float op = ((packed >> 24) & 0xFF) / 255.0 * OpacityScale;
                PhiOpacityBuffer[si] = float2(1.0, op);
            }
        }
        return;
    }

    // ===== 权重偏移 =====
    uint offW1 = 0;
    uint offB1 = H1 * MLPInputDim;
    uint offW2 = offB1 + H1;
    uint offB2 = offW2 + H2 * H1;
    uint offW3 = offB2 + H2;
    uint offB3 = offW3 + H3 * H2;
    uint offWphi = offB3 + H3;
    uint offBphi = offWphi + H3;
    uint offWop = offBphi + 1;
    uint offBop = offWop + H3;

    // ===== Phase 0: 组装输入 (前BATCH个线程, 每个组装1个splat) =====
    if (TIdx < BATCH)
    {
        uint si = baseSplat + TIdx;
        if (si < SplatCount)
        {
            uint idx = 0;

            // SH系数 (fp16 → fp32, L2-normalize)
            uint shCount = SHCoeffCount * 3;
            uint shBytes = shCount * 2;
            uint shBase = si * shBytes;
            float normSq = 0.0;
            for (uint s = 0; s < shCount; s += 2)
            {
                uint packed = SHBuffer.Load(shBase + s * 2);
                float v0 = f16tof32(packed & 0xFFFF);
                float v1 = f16tof32(packed >> 16);
                if (idx < MAX_SHARED_DIM) { gs_buf[TIdx][idx] = v0; normSq += v0 * v0; idx++; }
                if (s + 1 < shCount && idx < MAX_SHARED_DIM) { gs_buf[TIdx][idx] = v1; normSq += v1 * v1; idx++; }
            }
            float invN = (normSq > 1e-12) ? rsqrt(normSq) : 0.0;
            for (uint n = 0; n < idx; n++)
                gs_buf[TIdx][n] *= invN;

            // viewdir
            float3 pos = asfloat(PositionBuffer.Load3(si * 12));
            float3 vd = normalize(pos - CameraPosition);
            gs_buf[TIdx][idx++] = vd.x;
            gs_buf[TIdx][idx++] = vd.y;
            gs_buf[TIdx][idx++] = vd.z;

            // scale (L2-normalize)
            float3 sc = asfloat(ScaleBuffer.Load3(si * 12));
            float scSq = dot(sc, sc);
            sc *= (scSq > 1e-12) ? rsqrt(scSq) : 0.0;
            gs_buf[TIdx][idx++] = sc.x;
            gs_buf[TIdx][idx++] = sc.y;
            gs_buf[TIdx][idx++] = sc.z;

            // rotation
            float4 rot = asfloat(RotationBuffer.Load4(si * 16));
            gs_buf[TIdx][idx++] = rot.x;
            gs_buf[TIdx][idx++] = rot.y;
            gs_buf[TIdx][idx++] = rot.z;
            gs_buf[TIdx][idx++] = rot.w;
        }
        else
        {
            for (uint i = 0; i < MAX_SHARED_DIM; i++)
                gs_buf[TIdx][i] = 0.0;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // ===== Phase 1: Layer1 (InputDim → 256) + ReLU =====
    // 256个线程全部参与, 线程TIdx计算输出节点TIdx, 处理所有BATCH个splat
    // 每个权重值只从全局内存读一次, 乘以所有splat的对应输入
    {
        float sums[BATCH];
        float bias = MLPWeightsBuffer[offB1 + TIdx];
        for (uint s = 0; s < BATCH; s++)
            sums[s] = bias;

        uint rowBase = offW1 + TIdx * MLPInputDim;
        for (uint k = 0; k < MLPInputDim; k++)
        {
            float w = MLPWeightsBuffer[rowBase + k];
            for (uint s = 0; s < BATCH; s++)
                sums[s] += w * gs_buf[s][k];
        }

        for (uint s = 0; s < BATCH; s++)
            gs_h[s][TIdx] = max(sums[s], 0.0);
    }
    GroupMemoryBarrierWithGroupSync();

    // ===== Phase 2: Layer2 (256 → 128) + ReLU =====
    // 256线程全部参与: 分为2组×128线程, 每组处理 BATCH/2 个splat
    // 结果写入 gs_buf (复用, 不再需要原始输入)
    {
        uint outIdx = TIdx & 127u;          // TIdx % 128
        uint group = TIdx >> 7u;            // TIdx / 128 → 0 or 1
        uint sBase = group * (BATCH / 2);
        uint sEnd = sBase + (BATCH / 2);

        float sums[BATCH / 2];
        float bias = MLPWeightsBuffer[offB2 + outIdx];
        for (uint s = 0; s < BATCH / 2; s++)
            sums[s] = bias;

        uint rowBase = offW2 + outIdx * H1;
        for (uint k = 0; k < H1; k++)
        {
            float w = MLPWeightsBuffer[rowBase + k];
            for (uint s = 0; s < BATCH / 2; s++)
                sums[s] += w * gs_h[sBase + s][k];
        }

        for (uint s = 0; s < BATCH / 2; s++)
            gs_buf[sBase + s][outIdx] = max(sums[s], 0.0);
    }
    GroupMemoryBarrierWithGroupSync();

    // ===== Phase 3: Layer3 (128 → 64), 无激活 =====
    // 256线程: 4组×64线程, 每组处理 BATCH/4 个splat
    // 结果写入 gs_h 的前64列
    {
        uint outIdx = TIdx & 63u;           // TIdx % 64
        uint group = TIdx >> 6u;            // TIdx / 64 → 0..3
        uint sBase = group * (BATCH / 4);

        float sums[BATCH / 4];
        float bias = MLPWeightsBuffer[offB3 + outIdx];
        for (uint s = 0; s < BATCH / 4; s++)
            sums[s] = bias;

        uint rowBase = offW3 + outIdx * H2;
        for (uint k = 0; k < H2; k++)
        {
            float w = MLPWeightsBuffer[rowBase + k];
            for (uint s = 0; s < BATCH / 4; s++)
                sums[s] += w * gs_buf[sBase + s][k];
        }

        for (uint s = 0; s < BATCH / 4; s++)
            gs_h[sBase + s][outIdx] = sums[s];
    }
    GroupMemoryBarrierWithGroupSync();

    // ===== Phase 4: 输出头 (前BATCH个线程) =====
    if (TIdx < BATCH)
    {
        uint si = baseSplat + TIdx;
        if (si < SplatCount)
        {
            // Phi: Linear(64→1) + ReLU
            float phi = MLPWeightsBuffer[offBphi];
            for (uint k = 0; k < H3; k++)
                phi += MLPWeightsBuffer[offWphi + k] * gs_h[TIdx][k];
            phi = max(phi, 0.0);

            // Opacity: Linear(64→1) + Sigmoid
            float opLogit = MLPWeightsBuffer[offBop];
            for (uint k = 0; k < H3; k++)
                opLogit += MLPWeightsBuffer[offWop + k] * gs_h[TIdx][k];

            PhiOpacityBuffer[si] = float2(phi, 1.0 / (1.0 + exp(-opLogit)));
        }
    }
}
